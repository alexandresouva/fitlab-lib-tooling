{
  "name": "@fitlab/tooling",
  "version": "1.0.0",
  "description": "Ecosystem governance, linting, CLI, and AI helpers for FitLab",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": "./eslint/index.js",
    "./ai-templates/*": "./ai-templates/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "fitlab-tooling": "./dist/cli/index.js"
  },
  "schematics": "./dist/schematics/collection.json",
  "scripts": {
    "build": "node scripts/prebuild.mjs && tsc -p tsconfig.lib.json && node scripts/postbuild.mjs",
    "test": "vitest run",
    "prepare": "husky"
  },
  "keywords": [
    "fitlab",
    "mfe",
    "governance",
    "linting",
    "tooling"
  ],
  "author": "Alexandre Souza",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.1.0",
    "husky": "^9.1.7",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@angular-devkit/core": "^22.1.3",
    "@angular-devkit/schematics": "^22.1.3"
  }
}
