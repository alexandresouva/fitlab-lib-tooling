.card {
  background: #fff;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  padding: 20px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);

  .auth-box {
    margin-top: 20px;
    background: #f7f7f7;
    border-radius: 6px;
    padding: 15px;
    border-left: 4px solid #1a1a1a;

    .allowed {
      color: #2e7d32;
      font-weight: bold;
    }

    .denied {
      color: #c62828;
      font-weight: bold;
    }
  }
}
