import { ComponentFixture, TestBed } from '@angular/core/testing';
import { clearMfeContext, mockMfeContext } from '@fitlab/tooling/testing';
import { AngularTestHelper } from '@fitlab/tooling/testing/angular';
import { HomePage } from './home.page';

describe('HomePage', () => {
  let component: HomePage;
  let fixture: ComponentFixture<HomePage>;
  let helper: AngularTestHelper<HomePage>;

  beforeEach(async () => {
    clearMfeContext();

    await TestBed.configureTestingModule({
      imports: [HomePage],
    }).compileComponents();

    fixture = TestBed.createComponent(HomePage);
    component = fixture.componentInstance;
    helper = new AngularTestHelper(fixture);
  });

  afterEach(() => {
    clearMfeContext();
  });

  it('should create the component', () => {
    expect(component).toBeTruthy();
  });

  it('should display fallback state when window.mfeContext is undefined', () => {
    fixture.detectChanges();
    expect(component.token).toBe('No context token');
    expect(component.hasAdminAccess).toBe(false);

    const badgeText = helper.queries.getTextContent('admin-access-badge');
    expect(badgeText).toContain('DENIED');
  });

  it('should update token and grant admin access when mfeContext has matching permissions', () => {
    mockMfeContext({
      token: 'jwt-mock-token',
      permissions: ['<%= dasherize(name) %>:*'],
      workspaceId: 'ws_fitlab',
      user: {
        id: 'usr_1',
        name: 'Alexandre Souza',
        email: 'alexandre@example.com',
      },
      theme: 'dark',
      locale: 'pt-BR',
    });

    fixture.detectChanges();
    expect(component.token).toBe('jwt-mock-token');
    expect(component.hasAdminAccess).toBe(true);

    const badgeText = helper.queries.getTextContent('admin-access-badge');
    expect(badgeText).toContain('ALLOWED');
  });

  it('should update token but deny admin access when mfeContext has non-matching permissions', () => {
    mockMfeContext({
      token: 'guest-jwt-token',
      permissions: ['other-feature:*'],
      workspaceId: 'ws_fitlab',
      user: {
        id: 'usr_2',
        name: 'Guest User',
        email: 'guest@example.com',
      },
      theme: 'light',
      locale: 'en-US',
    });

    fixture.detectChanges();
    expect(component.token).toBe('guest-jwt-token');
    expect(component.hasAdminAccess).toBe(false);

    const badgeText = helper.queries.getTextContent('admin-access-badge');
    expect(badgeText).toContain('DENIED');
  });
});
