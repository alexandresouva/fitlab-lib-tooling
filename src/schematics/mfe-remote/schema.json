{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "FitlabMfeRemoteSchematicSchema",
  "title": "FitLab MFE Remote Schematic Options Schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the Micro Frontend remote.",
      "$default": {
        "$source": "argv",
        "index": 0
      }
    },
    "port": {
      "type": "number",
      "description": "The local development server port.",
      "default": 4201
    }
  },
  "required": [
    "name"
  ]
}
