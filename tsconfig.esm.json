{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "outDir": "./dist/esm",
    "rootDir": "./src"
  },
  "include": [
    "src/index.ts",
    "src/context/**/*",
    "src/permissions/**/*",
    "src/testing/**/*",
    "src/version.ts"
  ],
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts"]
}
